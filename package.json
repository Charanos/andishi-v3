    "db:seed:prod": "tsx --env-file=.env scripts/seed-prod.ts",
    "db:wipe:prod": "tsx --env-file=.env scripts/wipe-prod-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "biome format --write .",
