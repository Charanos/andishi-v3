# Neon Postgres - dev/prod split convention: put the PRODUCTION connection
# string in .env, and a separate DEV branch's connection string in
# .env.local (Next.js loads .env first, then .env.local overrides it for
# local development). Both files are gitignored; only this .example is
# committed. A Neon branch (schema + data cloned from production) is the
# easiest way to get a dev database without touching live data.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# Auth
JWT_SECRET=replace-with-at-least-64-random-hex-characters

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@andishi.dev

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Admin seed override
ADMIN_SEED_EMAIL=dennis@andishi.dev
ADMIN_SEED_PASSWORD=dennis-andishi@123
CLIENT_SEED_PASSWORD=client-andishi@123
DEVELOPER_SEED_PASSWORD=developer-andishi@123

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
